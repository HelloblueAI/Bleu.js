# Bleu.js environment template
# Copy to .env and replace the placeholders. Do not commit .env.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Application
ENV_NAME=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Required when ENV_NAME is production or staging (each value must be at least 32 characters)
SECRET_KEY=replace-with-a-random-string-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-different-random-string-32
JWT_SECRET=replace-with-another-random-string-32chars
ENCRYPTION_KEY=replace-with-another-random-string-32ch
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database. SQLite is enough for a local trial.
# DATABASE_URL=postgresql://user:password@localhost:5432/bleujs
DATABASE_URL=sqlite:///./bleujs.db

# Optional cache
# REDIS_URL=redis://localhost:6379/0

# Browser origins allowed to call a self-hosted app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# SDK and CLI (call the public API, or your own compatible server)
# BLEUJS_API_KEY=
# BLEUJS_BASE_URL=https://api.bleujs.org

# Optional model providers for a self-hosted app
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional IBM Quantum access for quantum extras
# QISKIT_IBM_TOKEN=

# Optional SMTP for self-hosted account email
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
